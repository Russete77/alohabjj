# Segredos
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db
.seen_urls.json
tracking/

# Base de conhecimento — uploads de runtime (mídia do usuário, não versionar)
knowledge/sources/*
