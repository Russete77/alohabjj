# Imagens de capa das noticias (baixadas da fonte, runtime)
web/public/hero/*
!web/public/hero/.gitkeep

# Candidatos de produto (saida do scout, runtime)
data/product_candidates.json
!data/.gitkeep

# Telemetria de runtime (o painel de custos lê local; não versionar)
jobs/

# Arte gerada pelo pipeline (regenerável; não versionar)
outputs/

# blocos de env gerados pro deploy (NUNCA versionar)
_VERCEL.env
_GITHUB-secrets.txt
